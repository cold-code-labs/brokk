{
  "name": "brokk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CCL's open-source AI coding-agent platform — cards, chat and review agents on a native lean kernel (Afl), forging code in isolated worktrees into PRs.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @brokk/api dev",
    "dev:web": "pnpm --filter @brokk/web dev",
    "lint": "pnpm -r --if-present lint",
    "eval": "tsx evals/run.ts",
    "test:isolation": "tsx --test packages/afl/src/enclave.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "next": "15.5.22",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<8.5.18": ">=8.5.18",
      "fast-uri@<3.1.4": ">=3.1.4",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "js-yaml@<3.15.0": ">=3.15.0",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "shell-quote@<1.9.0": ">=1.9.0",
      "hono": "4.12.26"
    }
  }
}
