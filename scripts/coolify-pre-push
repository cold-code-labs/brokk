#!/usr/bin/env bash
# Install: cp scripts/coolify-pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Auto-deploy Brokk on push to main via Coolify API (mirrors Heimdall's hook).
APP_UUID="p3yhl41ww6sw00wqnezpppnu"
COOLIFY_API="http://localhost:8000/api/v1"
TOKEN_FILE="$HOME/.coolify_token"

# Portao de compose antes do push. So HC001 (healthcheck rapido demais) reprova;
# HC002/HC003 avisam, porque ambos tem excecao legitima -- node:22-slim nao traz
# wget, e nem todo servico com healthcheck precisa de init.
# Nasceu do incidente da surtr em 2026-08-24: 43 ocorrencias do mesmo `interval: 5s`
# copiadas por 15 repos derrubaram o host a load 14.
if command -v python3 >/dev/null 2>&1 && [ -f scripts/lint-compose.py ]; then
  if ! python3 scripts/lint-compose.py docker-compose*.yml; then
    echo "brokk: push barrado — healthcheck rapido demais (veja HC001 acima)." >&2
    echo "       use interval: 30s + start_interval: 2s." >&2
    exit 1
  fi
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ -r "$TOKEN_FILE" ]; then
      ( sleep 6
        curl -s -H "Authorization: Bearer $(cat "$TOKEN_FILE")" \
          "$COOLIFY_API/deploy?uuid=$APP_UUID&force=false" >/dev/null 2>&1
      ) >/dev/null 2>&1 &
      disown 2>/dev/null
      echo "brokk: deploy do main agendado via Coolify API (sobe em ~1-2 min)."
    else
      echo "brokk: AVISO — $TOKEN_FILE ilegível, deploy automático NÃO disparado."
    fi
  fi
done

exit 0
